{
  "name": "johnnyxlemonade/email-generator",
  "description": "A component-based HTML email generator for Lemonade Framework.",
  "type": "library",
  "license": "Apache-2.0",
  "require": {
    "php": ">=8.3 <8.6",
    "johnnyxlemonade/framework": "dev-main"
  },
  "require-dev": {
    "friendsofphp/php-cs-fixer": "^3.94",
    "phpstan/phpstan": "2.3.0",
    "phpstan/phpstan-strict-rules": "2.1.0",
    "phpunit/phpunit": "^10.5"
  },
  "autoload": {
    "psr-4": {
      "Lemonade\\EmailGenerator\\": "src/"
    }
  },
  "autoload-dev": {
    "psr-4": {
      "Lemonade\\EmailGenerator\\Tests\\": "tests/"
    }
  },
  "scripts": {
    "test": "@php vendor/bin/phpunit --configuration=phpunit.xml.dist",
    "stan": "@php vendor/bin/phpstan analyse --memory-limit=4G --configuration=phpstan.neon.dist",
    "cs:check": "@php vendor/bin/php-cs-fixer fix --dry-run --diff --allow-risky=yes --config=.php-cs-fixer.php",
    "cs:fix": "@php vendor/bin/php-cs-fixer fix --allow-risky=yes --config=.php-cs-fixer.php",
    "examples": "@php examples/generate.php",
    "qa": [
      "@cs:check",
      "@stan",
      "@test"
    ]
  },
  "config": {
    "sort-packages": true,
    "allow-plugins": false
  },
  "minimum-stability": "dev",
  "prefer-stable": true
}
